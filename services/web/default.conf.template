# Rendered at container start by the nginx image (envsubst over /etc/nginx/templates).
# API_KEY is optional: when the API runs with API_KEYS set, the browser never sees the key; nginx adds it.
server {
    listen 80;

    # Resolve "api" through Docker's DNS on each request (cached 10 s), not once at startup. With a fixed
    # proxy_pass host, recreating or rescaling the api container (docker compose up -d, a .env change)
    # left nginx pointing at the old container IP and every /api/ call returned 502 until web restarted.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream http://api:8000;

    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Client-Id $remote_addr;
        proxy_set_header X-API-Key "${API_KEY}";
        proxy_read_timeout 30s;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html;
        add_header Cache-Control "no-cache";
    }
}
