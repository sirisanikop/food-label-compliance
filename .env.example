# Copy to .env and edit. Compose reads this file first, then .env (overrides).
# No real secrets belong in this file. Put your provider key in .env (git-ignored).

# --- Model provider (any OpenAI-compatible chat-completions endpoint) ---------
# Default points at the local stub service so a clean clone runs at zero cost.
# To use a real provider's free tier, override these three in .env.
LLM_BASE_URL=http://llm-stub:8080/v1
LLM_API_KEY=not-needed-for-stub
LLM_MODEL=change-me
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE_S=0.5
BREAKER_FAIL_THRESHOLD=5
BREAKER_RESET_S=30
# Price per 1000 tokens in USD (0 for free tier). Used for cost attribution (L5).
PRICE_IN_PER_1K=0
PRICE_OUT_PER_1K=0

# --- Embeddings (local sentence-transformers model name) ----------------------
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_K=5

# --- Agent loop limits (A1) ---------------------------------------------------
MAX_STEPS=12
MAX_TOOL_CALLS=10
RUN_TIMEOUT_S=90
TOOL_TIMEOUT_S=10
MAX_VERIFY_ATTEMPTS=2
# The ONE product category your corpus covers. Requests outside it are escalated.
CORPUS_CATEGORY=Biscuits, cookies and cereal bars

# --- Verifier agent (A2/A3) ---------------------------------------------------
VERIFIER_URL=http://verifier:8001
VERIFIER_TIMEOUT_S=20
VERIFIER_USE_LLM=false

# --- Prompt versions (L2). Unset = v1 ---------------------------------------
PROMPT_VERSION_CLASSIFY=v1
PROMPT_VERSION_ANALYST=v1
PROMPT_VERSION_VERIFIER_JUDGE=v1

# --- Performance controls (D7) ------------------------------------------------
RATE_LIMIT_PER_MIN=30
CACHE_TTL_S=3600
ENABLE_RUN_CACHE=true

# --- Platform -----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
OTLP_ENDPOINT=http://jaeger:4318
LOG_LEVEL=INFO
WORKER_THREADS=1
WORKER_METRICS_PORT=9100
LIVE_SCORE_SAMPLE_RATE=0.1
STUB_DELAY_MS=800
# Demonstration fault injection for the stub model (leave empty normally):
#   wrong_source_once | bad_quote_once | always_bad_quote | http_500
STUB_FAULT=
